# Copy this file to .env and fill in your own values.
# Lines starting with # are comments.

# Which AI provider to use: gemini, ollama, lmstudio, or llama-server
AI_PROVIDER=gemini

# Google Gemini (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Mistral (only needed if you use Mistral OCR — https://console.mistral.ai)
MISTRAL_API_KEY=
OCR_PROVIDER=mistral

# Local AI servers (only needed if you run models on your own computer)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=
LLAMA_SERVER_BASE_URL=http://localhost:8012
LLAMA_SERVER_MODEL=

# Zotero (get your user ID and API key at https://www.zotero.org/settings/keys)
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_MODE=remote

# Model behavior
REASONING=off
TEMPERATURE=0.3
MAX_TOKENS=2048

# Django — generate a secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_LOG_LEVEL=INFO
